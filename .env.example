```bash
# ============================================================
# AcadémIA Pro — Variables d'environnement
# ============================================================
# Copier ce fichier : cp .env.example .env.local
# Ne jamais commiter .env.local dans Git
# Toutes les variables NEXT_PUBLIC_* sont exposées côté client
# ============================================================


# ============================================================
# SUPABASE — Base de données & authentification
# https://supabase.com/dashboard/project/_/settings/api
# ============================================================

# URL publique du projet Supabase (ex: https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clé anonyme publique — lecture seule côté client
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service role — accès total côté serveur uniquement
# ⚠️  Ne jamais exposer côté client
SUPABASE_SERVICE_ROLE_KEY=


# ============================================================
# NEXTAUTH — Gestion des sessions
# https://next-auth.js.org/configuration/options
# ============================================================

# URL de base de l'application en production
NEXTAUTH_URL=https://academiapro.vercel.app

# Secret aléatoire pour signer les tokens JWT
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET=


# ============================================================
# GOOGLE OAUTH — Connexion avec Google
# https://console.cloud.google.com/apis/credentials
# ============================================================

# ID client OAuth 2.0 Google
GOOGLE_CLIENT_ID=

# Secret client OAuth 2.0 Google
GOOGLE_CLIENT_SECRET=


# ============================================================
# APPLE OAUTH — Connexion avec Apple
# https://developer.apple.com/account/resources/identifiers
# ============================================================

# Bundle ID / Services ID de l'app Apple (ex: com.academiapro.app)
APPLE_ID=

# Team ID du compte développeur Apple (10 caractères)
APPLE_TEAM_ID=

# Clé privée P8 téléchargée depuis Apple Developer
# Remplacer les sauts de ligne par \n dans la valeur
APPLE_PRIVATE_KEY=

# Key ID associé à la clé privée P8 (10 caractères)
APPLE_KEY_ID=


# ============================================================
# ANTHROPIC — IA conversationnelle (Claude)
# https://console.anthropic.com/settings/keys
# ============================================================

# Clé API Anthropic pour accéder aux modèles Claude
# ⚠️  Côté serveur uniquement
ANTHROPIC_API_KEY=


# ============================================================
# RESEND — Envoi d'emails transactionnels
# https://resend.com/api-keys
# ============================================================

# Clé API Resend
RESEND_API_KEY=

# Adresse expéditrice vérifiée sur le domaine Resend
RESEND_FROM_EMAIL=contact@academiapro.fr


# ============================================================
# STRIPE — Paiements & abonnements
# https://dashboard.stripe.com/apikeys
# ============================================================

# Clé publique Stripe — exposée côté client pour Stripe.js
STRIPE_PUBLIC_KEY=

# Clé secrète Stripe — côté serveur uniquement
# ⚠️  Ne jamais exposer côté client
STRIPE_SECRET_KEY=

# Secret du webhook Stripe (préfixe whsec_)
# Généré dans : Dashboard → Webhooks → Signing secret
STRIPE_WEBHOOK_SECRET=


# ============================================================
# DAILY.CO — Visioconférence tuteurs/élèves
# https://dashboard.daily.co/developers
# ============================================================

# Clé API Daily.co pour créer et gérer les rooms vidéo
DAILY_API_KEY=


# ============================================================
# HEYGEN — Avatars vidéo IA
# https://app.heygen.com/settings?nav=API
# ============================================================

# Clé API HeyGen pour la génération d'avatars pédagogiques
HEYGEN_API_KEY=


# ============================================================
# ELEVENLABS — Synthèse vocale IA
# https://elevenlabs.io/app/settings/api-keys
# ============================================================

# Clé API ElevenLabs pour la génération de voix réalistes
ELEVENLABS_API_KEY=


# ============================================================
# TWILIO — SMS & notifications téléphoniques
# https://console.twilio.com/
# ============================================================

# SID du compte Twilio (préfixe AC)
TWILIO_ACCOUNT_SID=

# Token d'authentification Twilio
# ⚠️  Ne jamais exposer côté client
TWILIO_AUTH_TOKEN=

# Numéro Twilio expéditeur au format E.164 (ex: +33700000000)
TWILIO_PHONE_NUMBER=


# ============================================================
# FIN DU FICHIER
# ============================================================
```